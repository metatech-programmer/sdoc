# ============================================================
# SDOC Web — Variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores.
# ============================================================

# URL base del API. En dev usa el proxy de Vite (/api/v1).
# En producción, apunta al gateway desplegado.
VITE_API_URL=/api/v1

# URL base del WebSocket de sincronización Yjs.
# Ejemplo prod: wss://api.tudominio.com/ws/sync
VITE_WS_URL=ws://localhost:8085/ws/sync

# Targets que usa el proxy de `vite dev` (solo desarrollo).
VITE_API_PROXY=http://localhost:8080
VITE_WS_PROXY=ws://localhost:8085

# Modo demo: si "true", la app usa datos mockeados cuando el backend no responde.
VITE_DEMO_MODE=false

# Branding overridable (útil para white-label).
VITE_BRAND_NAME=SDOC
VITE_SUPPORT_EMAIL=hola@example.com
