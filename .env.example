# ============================================================
# SDOC Platform — Variables de Entorno
# Copiar a .env y completar con valores reales
# NUNCA commitear .env con valores reales
# ============================================================

# Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sdoc_db
POSTGRES_USER=sdoc
POSTGRES_PASSWORD=changeme_postgres_password

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# ---- Kafka ----
KAFKA_BROKERS=kafka:9092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ---- MinIO / Object Storage ----
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=sdoc-admin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_ENDPOINT=http://minio:9000
# En producción usar Cloudflare R2:
# MINIO_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ---- Keycloak ----
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=sdoc
KEYCLOAK_CLIENT_ID=sdoc-backend
KEYCLOAK_CLIENT_SECRET=changeme_keycloak_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin_password

# ---- HashiCorp Vault ----
VAULT_HOST=vault
VAULT_PORT=8200
VAULT_TOKEN=changeme_vault_root_token
VAULT_ADDR=http://vault:8200

# ---- Config Server ----
CONFIG_SERVER_URI=http://config-server:8888
CONFIG_SERVER_USER=config-admin
CONFIG_SERVER_PASSWORD=changeme_config_server_password
CONFIG_REPO_URI=file:///config-repo
CONFIG_ENCRYPT_KEY=changeme_config_encrypt_key_32chars

# ---- Eureka ----
EUREKA_URL=http://eureka:8761/eureka/
EUREKA_USER=eureka-admin
EUREKA_PASSWORD=changeme_eureka_password

# ---- OPA ----
OPA_HOST=opa
OPA_PORT=8181

# ---- Cifrado de documentos ----
DOCUMENT_ENCRYPTION_KEY=changeme_aes_256_key_32_bytes_hex
DOCUMENT_SIGNING_PRIVATE_KEY=changeme_ed25519_private_key_base64

# ---- Email (Resend) ----
RESEND_API_KEY=re_changeme_resend_api_key
EMAIL_FROM=noreply@sdoc.app
EMAIL_FROM_NAME=SDOC Platform

# ---- Stripe (monetización) ----
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_PRICE_PRO_MONTHLY=price_changeme_pro_monthly
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_changeme_enterprise_monthly

# ---- Frontend ----
VITE_API_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8090
VITE_KEYCLOAK_REALM=sdoc
VITE_KEYCLOAK_CLIENT_ID=sdoc-web
VITE_WS_URL=ws://localhost:8080

# ---- Observabilidad ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
JAEGER_ENDPOINT=http://jaeger:4317

# ---- Unleash (Feature Flags) ----
UNLEASH_API_URL=http://unleash:4242/api
UNLEASH_API_TOKEN=changeme_unleash_token

# ---- CI/CD ----
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=tu-org/sdoc
