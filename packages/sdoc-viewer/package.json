{
  "name": "@sdoc/viewer",
  "version": "1.0.0",
  "description": "Viewer read-only embebible del formato .sdoc. Sin dependencias de framework — vanilla DOM.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sdoc/format": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "jsdom": "^24.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sdoc",
    "viewer",
    "read-only",
    "embed"
  ]
}
